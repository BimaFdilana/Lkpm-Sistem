APP_NAME="Sistem Target Investasi Satgas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lkpm.example.go.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lkpm_production
DB_USERNAME=lkpm_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1260
PRIORITY_SNAPSHOT_TIME=08:15

FILESYSTEM_DISK=local

GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_OAUTH_CREDENTIALS=/var/www/lkpm/secure/google-drive-oauth-client.json
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=https://lkpm.example.go.id/google-drive/callback
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_DP_PROYEK_FOLDER_ID=
GOOGLE_DRIVE_LKPM_FOLDER_ID=
GOOGLE_DRIVE_SECTOR_FOLDER_ID=
GOOGLE_DRIVE_FAILED_IMPORTS_FOLDER_ID=
GOOGLE_DRIVE_ARCHIVE_FOLDER_ID=
